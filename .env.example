# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real API keys.

# Required: get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Verify current model slugs at https://openrouter.ai/models — must
# support tool calling.
CHAT_MODEL=anthropic/claude-sonnet-4.5

# Redis connection used for BOTH the checkpointer (short-term memory)
# and the store (long-term memory). Only needed to run the LIVE service
# (app/main.py) — the evaluation suite (evaluation/, tests/test_regression.py)
# runs hermetically with in-memory persistence and does NOT need Redis.
REDIS_URL=redis://localhost:6379

# Agent loop safety valves — see app/safety.py.
MAX_ITERATIONS=8
RECURSION_LIMIT=50

REQUEST_TIMEOUT_SECONDS=60

# New in Week 5 — optional. If unset, AgentTracer (telemetry/tracing.py)
# degrades gracefully to local-only recording (no Langfuse dashboard,
# but /telemetry and the eval suite's cost/latency data still work).
# Get these at https://cloud.langfuse.com (or your self-hosted instance).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
